---
import '../styles/global.css';
const products = [
  {
    id: 1,
    name: "AirStride Runner",
    category: "رياضي",
    price: "2,450 ج.م",
    badge: "الأكثر مبيعاً",
    colors: ["#111827", "#DC2626", "#2563EB"],
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 2,
    name: "Urban Classic Leather",
    category: "كاجوال",
    price: "1,950 ج.م",
    badge: "جديد",
    colors: ["#78350F", "#000000"],
    image: "https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 3,
    name: "AeroBoost Pro",
    category: "رياضي",
    price: "3,100 ج.م",
    badge: "خصم 15%",
    colors: ["#059669", "#F59E0B", "#111827"],
    image: "https://images.unsplash.com/photo-1606107557195-0e29a4b5b4aa?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 4,
    name: "Oxford Elite",
    category: "كلاسيك",
    price: "2,800 ج.م",
    badge: "",
    colors: ["#451A03", "#1F2937"],
    image: "https://images.unsplash.com/photo-1614252235316-8c857d38b5f4?auto=format&fit=crop&w=600&q=80"
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>خطوة | متجر الأحذية العصرية</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Cairo', sans-serif; }
    </style>
  </head>

  <body class="bg-gray-50 text-gray-900 antialiased">
    <!-- Navbar -->
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="#" class="text-2xl font-black tracking-tight text-indigo-600">خطوة<span class="text-gray-900">.</span></a>
        
        <nav class="hidden md:flex gap-8 font-semibold text-sm text-gray-600">
          <a href="#collection" class="hover:text-indigo-600 transition">التشكيلة</a>
          <a href="#features" class="hover:text-indigo-600 transition">المميزات</a>
          <a href="#offer" class="hover:text-indigo-600 transition">العروض</a>
        </nav>

        <button id="cart-btn" class="relative bg-gray-900 text-white px-4 py-2 rounded-full text-sm font-bold hover:bg-indigo-600 transition flex items-center gap-2 cursor-pointer">
          <span>السلة</span>
          <span id="cart-count" class="bg-indigo-500 text-white text-xs px-2 py-0.5 rounded-full">0</span>
        </button>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="max-w-6xl mx-auto px-4 py-12 md:py-20 grid md:grid-cols-2 gap-10 items-center">
      <div class="space-y-6">
        <span class="inline-block bg-indigo-50 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full">
          تشكيلة شتاء 2026 الجديدة
        </span>
        <h1 class="text-4xl md:text-6xl font-black leading-tight text-gray-900">
          راحة في كل خطوة، <span class="text-indigo-600">وأناقة</span> تلفت الأنظار.
        </h1>
        <p class="text-gray-600 text-lg leading-relaxed">
          تصميمات طبية وخامات فائقة الجودة مصممة خصيصاً لحركتك اليومية، سواء في الجيم، الشغل، أو الخروجات.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="#collection" class="bg-indigo-600 text-white px-8 py-4 rounded-xl font-bold shadow-lg shadow-indigo-200 hover:bg-indigo-700 transition">
            تسوق الآن
          </a>
          <a href="#features" class="bg-white border border-gray-200 text-gray-800 px-8 py-4 rounded-xl font-bold hover:bg-gray-100 transition">
            اكتشف الخامات
          </a>
        </div>
      </div>

      <!-- Interactive Hero Showcase -->
      <div class="relative bg-gradient-to-tr from-indigo-100 to-purple-50 rounded-3xl p-8 flex flex-col items-center">
        <img 
  id="hero-shoe"
  src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=700&q=80" 
  alt="حذاء رياضي" 
  class="w-full max-w-sm h-72 object-cover rounded-2xl drop-shadow-xl transition-all duration-500 hover:scale-105"
/>  <!-- مبدل الألوان التفاعلي -->
        <div class="mt-6 bg-white/90 backdrop-blur px-5 py-3 rounded-2xl shadow-sm flex items-center gap-4">
          <span class="text-xs font-bold text-gray-500">جرب الألوان:</span>
          <button data-filter="hue-rotate(0deg)" class="color-dot w-6 h-6 rounded-full bg-red-600 ring-2 ring-offset-2 ring-red-600 cursor-pointer"></button>
          <button data-filter="hue-rotate(210deg)" class="color-dot w-6 h-6 rounded-full bg-blue-600 cursor-pointer"></button>
          <button data-filter="hue-rotate(110deg)" class="color-dot w-6 h-6 rounded-full bg-emerald-600 cursor-pointer"></button>
          <button data-filter="grayscale(100%)" class="color-dot w-6 h-6 rounded-full bg-gray-900 cursor-pointer"></button>
        </div>
      </div>
    </section>

    <!-- Products Section with Filter -->
    <section id="collection" class="max-w-6xl mx-auto px-4 py-16">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
        <div>
          <h2 class="text-3xl font-black">أحدث الموديلات</h2>
          <p class="text-gray-500 mt-1">اختر الفئة المناسبة لستايلك</p>
        </div>

        <!-- أزرار الفلترة -->
        <div class="flex gap-2 bg-gray-200/70 p-1.5 rounded-xl w-fit">
          <button data-cat="all" class="filter-btn bg-white text-gray-900 px-4 py-2 rounded-lg text-sm font-bold shadow-sm cursor-pointer">الكل</button>
          <button data-cat="رياضي" class="filter-btn text-gray-600 px-4 py-2 rounded-lg text-sm font-bold hover:text-gray-900 cursor-pointer">رياضي</button>
          <button data-cat="كاجوال" class="filter-btn text-gray-600 px-4 py-2 rounded-lg text-sm font-bold hover:text-gray-900 cursor-pointer">كاجوال</button>
          <button data-cat="كلاسيك" class="filter-btn text-gray-600 px-4 py-2 rounded-lg text-sm font-bold hover:text-gray-900 cursor-pointer">كلاسيك</button>
        </div>
      </div>

      <!-- شبكة المنتجات -->
      <div id="products-grid" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {products.map((item) => (
          <div data-category={item.category} class="product-card bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-xl transition group">
            <div class="relative h-56 bg-gray-100 overflow-hidden">
              {item.badge && (
                <span class="absolute top-3 right-3 z-10 bg-gray-900 text-white text-xs font-bold px-3 py-1 rounded-full">
                  {item.badge}
                </span>
              )}
              <img 
                src={item.image} 
                alt={item.name} 
                class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
              />
            </div>

            <div class="p-5 space-y-3">
              <div class="flex justify-between items-center text-xs text-gray-400 font-semibold">
                <span>{item.category}</span>
                <div class="flex gap-1">
                  {item.colors.map((c) => (
                    <span class="w-3 h-3 rounded-full border border-gray-200" style={`background-color: ${c}`}></span>
                  ))}
                </div>
              </div>

              <h3 class="font-bold text-lg text-gray-900">{item.name}</h3>
              
              <div class="pt-2 flex items-center justify-between border-t border-gray-100">
                <span class="font-black text-indigo-600 text-lg">{item.price}</span>
                <button 
                  data-name={item.name}
                  class="add-to-cart bg-gray-900 text-white text-xs font-bold px-4 py-2.5 rounded-xl hover:bg-indigo-600 transition cursor-pointer"
                >
                  + أضف للسلة
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="bg-white border-y border-gray-100 py-16">
      <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-3 gap-8 text-center">
        <div class="p-6 rounded-2xl bg-gray-50">
          <div class="text-3xl mb-3">🚚</div>
          <h3 class="font-bold text-lg mb-1">شحن سريع ومجاني</h3>
          <p class="text-sm text-gray-500">توصيل خلال 48 ساعة لجميع المحافظات مع إمكانية المعاينة قبل الاستلام.</p>
        </div>
        <div class="p-6 rounded-2xl bg-gray-50">
          <div class="text-3xl mb-3">🔄</div>
          <h3 class="font-bold text-lg mb-1">استبدال واسترجاع مجاني</h3>
          <p class="text-sm text-gray-500">المقاس مش مظبوط؟ بنبدلهولك مجاناً خلال 14 يوم بدون أي مصاريف إضافية.</p>
        </div>
        <div class="p-6 rounded-2xl bg-gray-50">
          <div class="text-3xl mb-3">🛡️</div>
          <h3 class="font-bold text-lg mb-1">ضمان 6 شهور</h3>
          <p class="text-sm text-gray-500">ضمان حقيقي ضد عيوب الصناعة على النعل والخامات الجلدية.</p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="max-w-6xl mx-auto px-4 py-8 text-center text-sm text-gray-500">
      © 2026 متجر خطوة للأحذية. جميع الحقوق محفوظة.
    </footer>

    <!-- Client-Side Interactivity (Astro Script) -->
    <script>
      // 1. تغيير لون الحذاء في الـ Hero
      const heroShoe = document.getElementById('hero-shoe');
      const colorDots = document.querySelectorAll('.color-dot');

      colorDots.forEach(dot => {
        dot.addEventListener('click', () => {
          const filter = dot.getAttribute('data-filter');
          if (heroShoe && filter) heroShoe.style.filter = filter;

          colorDots.forEach(d => d.classList.remove('ring-2', 'ring-offset-2'));
          dot.classList.add('ring-2', 'ring-offset-2');
        });
      });

      // 2. فلترة المنتجات حسب الفئة
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.product-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat');

          filterBtns.forEach(b => {
            b.classList.remove('bg-white', 'text-gray-900', 'shadow-sm');
            b.classList.add('text-gray-600');
          });
          btn.classList.add('bg-white', 'text-gray-900', 'shadow-sm');
          btn.classList.remove('text-gray-600');

          cards.forEach(card => {
            const cardCat = card.getAttribute('data-category');
            if (cat === 'all' || cardCat === cat) {
              (card as HTMLElement).style.display = 'block';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      // 3. عداد السلة التفاعلي
      let count = 0;
      const cartCount = document.getElementById('cart-count');
      const addBtns = document.querySelectorAll('.add-to-cart');

      addBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          count++;
          if (cartCount) cartCount.textContent = count.toString();
          
          const originalText = btn.textContent;
          btn.textContent = '✓ تمت الإضافة';
          btn.classList.replace('bg-gray-900', 'bg-emerald-600');
          
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.replace('bg-emerald-600', 'bg-gray-900');
          }, 1000);
        });
      });
    </script>
  </body>
</html>